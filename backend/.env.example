# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_USER=postgres.your-project-id
DB_PASSWORD=your-password
DB_NAME=postgres
DB_PORT=6543
DB_CONNECTION_LIMIT=10

# JWT Configuration
JWT_SECRET=grafenda_super_secret_key_2024_marketplace_jwt_token_v1
JWT_EXPIRE=7d

# File Upload Configuration
UPLOAD_PATH=uploads/
MAX_FILE_SIZE=5242880  # 5MB in bytes
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Email Configuration (for future use)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your.real.email@gmail.com
MAIL_PASS=your_gmail_app_password
MAIL_FROM=your.real.email@gmail.com
MAIL_SECURE=false

# Frontend URL for password reset links
FRONTEND_URL=http://localhost:5173
RESET_PASSWORD_SECRET=replace_this_with_a_random_secret_string

# Payment Configuration (for future use)
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_ENVIRONMENT=sandbox

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW=15  # minutes
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
UPLOAD_RATE_LIMIT_MAX=10

# Supabase Configuration
# SUPABASE_URL: Project URL dari dashboard Supabase
# SUPABASE_KEY: anon/public key dari Project Settings > API
# SUPABASE_SERVICE_KEY: service_role key dari Project Settings > API (lebih powerful, untuk operasi Storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key